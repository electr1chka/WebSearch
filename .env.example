# LLM is optional. OpenRouter free router is the default target when OPENROUTER_API_KEY is set.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:8787
OPENROUTER_APP_TITLE=AI Web Search Agent

# Optional OpenAI fallback. If omitted, the agent uses OpenRouter or local heuristics only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional search providers. Add one or more.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=

# Optional extraction/rendering providers.
FIRECRAWL_API_KEY=

# Runtime knobs.
DEFAULT_COUNTRY=UA
DEFAULT_LANGUAGE=uk
MAX_RESULTS=12
MAX_PAGES_TO_FETCH=8
FETCH_MODE=auto
STORAGE_PATH=results/search-history.jsonl
AI_ANALYSIS_ENABLED=false
